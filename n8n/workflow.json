            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Alert - All Checks OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Alert Message": {
      "main": [
        [
          {
            "node": "Send Notification (placeholder)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
